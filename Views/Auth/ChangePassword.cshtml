@model QuanLyTourDuLich.ViewModels.ChangePasswordVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đổi Mật Khẩu";
    ViewData["ActiveMenu"] = "Dashboard";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-3 px-4 text-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-2">
                        <i class="fa-solid fa-key fa-xl"></i>
                    </div>
                    <h5 class="fw-bold text-slate-800 mb-1">Đổi Mật Khẩu</h5>
                    <p class="text-muted small mb-0">Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 px-3 text-start small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold text-muted small mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input asp-for="CurrentPassword" class="form-control border-start-0 bg-light" placeholder="Nhập mật khẩu hiện tại" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-muted small mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fa-solid fa-lock-open"></i>
                                </span>
                                <input asp-for="NewPassword" class="form-control border-start-0 bg-light" placeholder="Mật khẩu mới tối thiểu 6 ký tự" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold text-muted small mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fa-solid fa-circle-check"></i>
                                </span>
                                <input asp-for="ConfirmNewPassword" class="form-control border-start-0 bg-light" placeholder="Xác nhận mật khẩu mới" />
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-semibold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Lưu Thay Đổi
                            </button>
                            <a href="/Admin" class="btn btn-light w-100 py-2.5 rounded-3 fw-semibold">
                                <i class="fa-solid fa-xmark me-2"></i>Hủy Bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
