@model QuanLyTourDuLich.ViewModels.DashboardViewModel
@{
    Layout = null; // Hoàn toàn không dùng layout admin
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In Báo Cáo Thống Kê</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/style.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #334155;
            background-color: #fff;
            padding: 40px;
        }
        .report-header {
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .report-title {
            font-weight: 800;
            color: #1e293b;
            text-transform: uppercase;
        }
        .stat-box {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            height: 100%;
        }
        .stat-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: #2563eb;
            margin-bottom: 5px;
        }
        .table-custom th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }
        .signature-section {
            margin-top: 60px;
        }
        .btn-print-action {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }
        @@media print {
            body {
                padding: 0;
            }
            .btn-print-action {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Floating Action Button to Print -->
    <div class="btn-print-action">
        <button onclick="window.print();" class="btn btn-primary btn-lg rounded-pill px-4">
            <i class="fa-solid fa-print me-2"></i>In Báo Cáo / Lưu PDF
        </button>
        <button onclick="window.close();" class="btn btn-light btn-lg rounded-pill border px-4 ms-2">
            Đóng
        </button>
    </div>

    <div class="container">
        <!-- Header -->
        <div class="report-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h5 class="fw-bold text-primary mb-1"><i class="fa-solid fa-plane-departure me-2"></i>ANTIGRAVITY TRAVEL</h5>
                    <p class="text-muted small mb-0">Hệ Thống Quản Lý Tour Du Lịch Toàn Diện</p>
                </div>
                <div class="col-6 text-end">
                    <p class="text-muted small mb-1">Mẫu báo cáo: <strong>RP-001/SYS</strong></p>
                    <p class="text-muted small mb-0">Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <!-- Title -->
        <div class="text-center my-4">
            <h3 class="report-title">Báo Cáo Thống Kê Hoạt Động Kinh Doanh</h3>
            <p class="text-muted">Tổng hợp hiệu suất hoạt động, doanh thu và lượng khách hàng đăng ký</p>
        </div>

        <!-- General Stats Box -->
        <div class="row g-4 my-4">
            <div class="col-3">
                <div class="stat-box">
                    <div class="stat-value">@Model.TongSoTour</div>
                    <div class="text-uppercase text-muted fs-8 font-weight-semibold">Tour Hiện Có</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="stat-value text-success">@Model.TongDoanhThu.ToString("N0") đ</div>
                    <div class="text-uppercase text-muted fs-8 font-weight-semibold">Tổng Doanh Thu</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="stat-value text-purple" style="color: #8b5cf6;">@Model.TongLuotKhach</div>
                    <div class="text-uppercase text-muted fs-8 font-weight-semibold">Tổng Lượt Khách</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="stat-value text-warning" style="color: #f59e0b;">@Model.TongSoDoan</div>
                    <div class="text-uppercase text-muted fs-8 font-weight-semibold">Đoàn Khởi Hành</div>
                </div>
            </div>
        </div>

        <!-- Chart Data Table -->
        <div class="card border-0 my-5">
            <div class="card-body p-0">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-chart-simple text-primary me-2"></i>Top Tour Có Lượng Đăng Ký Cao Nhất</h5>
                <table class="table table-bordered table-custom align-middle">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 80px;">STT</th>
                            <th>Tên Tour Du Lịch</th>
                            <th class="text-center" style="width: 250px;">Số Lượng Khách Đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            foreach (var tour in Model.TopTours)
                            {
                                <tr>
                                    <td class="ps-3 text-center">@stt</td>
                                    <td class="fw-semibold">@tour.TenTour</td>
                                    <td class="text-center font-weight-bold text-primary">@tour.SoKhachDat lượt khách</td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Signature Section -->
        <div class="signature-section mt-5">
            <div class="row text-center">
                <div class="col-6">
                    <p class="text-muted mb-5">Người lập báo cáo<br/><small>(Ký và ghi rõ họ tên)</small></p>
                    <div style="height: 60px;"></div>
                    <strong class="text-dark">Hệ Thống Tự Động</strong>
                </div>
                <div class="col-6">
                    <p class="text-muted mb-5">Xác nhận của Giám Đốc<br/><small>(Ký tên đóng dấu)</small></p>
                    <div style="height: 60px;"></div>
                    <strong class="text-dark">Ban Giám Đốc</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tự động gọi in sau khi load hoàn tất
        window.addEventListener("DOMContentLoaded", function() {
            setTimeout(function() {
                window.print();
            }, 500);
        });
    </script>
</body>
</html>
