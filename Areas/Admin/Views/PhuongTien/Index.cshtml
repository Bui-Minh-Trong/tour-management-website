@model IEnumerable<QuanLyTourDuLich.ViewModels.PhuongTienViewModel>

@{
    ViewData["Title"] = "Quản lý Phương Tiện";
    ViewData["ActiveMenu"] = "PhuongTien";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-bus text-primary me-2"></i>Quản Lý Phương Tiện
            </h1>
            <p class="text-muted mb-0">Quản lý đội xe, phương tiện vận tải phục vụ đưa đón khách của công ty du lịch.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/PhuongTien/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Thêm Xe Mới
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Vehicles Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã</th>
                        <th>Biển Số Xe</th>
                        <th>Loại Xe</th>
                        <th class="text-center">Số Chỗ Ngồi</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaPhuongTien</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 font-mono fs-6 fw-bold">@item.BienSoXe</span>
                                </td>
                                <td>
                                    <div class="font-weight-semibold text-dark">@item.LoaiXe</div>
                                </td>
                                <td class="text-center font-weight-bold text-dark">
                                    @item.SoChoNgoi <small class="text-muted">chỗ</small>
                                </td>
                                <td>
                                    @if (item.TrangThai == "Hoạt động" || item.TrangThai == "Sẵn sàng")
                                    {
                                        <span class="badge bg-success px-3 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Sẵn sàng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-1.5 rounded-pill"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Đang bảo trì</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <form action="/Admin/PhuongTien/Delete/@item.MaPhuongTien" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phương tiện này khỏi đội xe?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-bus fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có phương tiện nào trong danh sách.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
