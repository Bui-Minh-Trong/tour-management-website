@model IEnumerable<QuanLyTourDuLich.ViewModels.KhuyenMaiViewModel>

@{
    ViewData["Title"] = "Quản lý Khuyến Mãi";
    ViewData["ActiveMenu"] = "KhuyenMai";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-tags text-primary me-2"></i>Quản Lý Khuyến Mãi & Giảm Giá
            </h1>
            <p class="text-muted mb-0">Quản lý các chương trình ưu đãi, phát hành mã giảm giá cho khách đặt tour.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/KhuyenMai/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Tạo Mã Giảm Giá
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo mã code..." />
            </div>
        </div>
    </div>

    <!-- Promotions Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="khuyenMaiTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã</th>
                        <th>Mã Code</th>
                        <th class="text-center">% Giảm</th>
                        <th class="text-end">Tiền Giảm Trực Tiếp</th>
                        <th>Ngày Bắt Đầu</th>
                        <th>Ngày Hết Hạn</th>
                        <th class="text-center" style="width: 150px;">Số Lượng Đã Dùng</th>
                        <th class="text-center" style="width: 150px;">Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isActive = item.NgayBatDau <= DateOnly.FromDateTime(DateTime.Today) && item.NgayHetHan >= DateOnly.FromDateTime(DateTime.Today);
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaKm</td>
                                <td>
                                    <span class="badge bg-blue-light text-primary px-3 py-2 rounded font-mono fs-6" style="letter-spacing: 1px;">@item.Code</span>
                                </td>
                                <td class="text-center font-weight-bold text-dark">
                                    @(item.PhanTramGiam.HasValue ? $"{item.PhanTramGiam.Value.ToString("G0")}%" : "0%")
                                </td>
                                <td class="text-end font-weight-bold text-danger">
                                    @(item.TienGiamTrucTiep.HasValue ? $"{item.TienGiamTrucTiep.Value.ToString("N0")} VND" : "0 VND")
                                </td>
                                <td>
                                    <span class="text-muted"><i class="fa-regular fa-calendar-check me-1 text-success"></i>@item.NgayBatDau.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="fa-regular fa-calendar-times me-1 text-danger"></i>@item.NgayHetHan.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="text-center font-weight-semibold text-dark">
                                    @item.SoLuongDaDung lượt
                                </td>
                                <td class="text-center">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success px-3 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Đang chạy</span>
                                    }
                                    else if (item.NgayBatDau > DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="badge bg-secondary px-3 py-1.5 rounded-pill"><i class="fa-solid fa-clock me-1"></i>Chưa chạy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-1.5 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i>Hết hạn</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <form action="/Admin/KhuyenMai/Delete/@item.MaKm" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã khuyến mãi này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa mã">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-tags fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có chương trình khuyến mãi nào được tạo.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const tableRows = document.querySelectorAll("#khuyenMaiTable tbody tr");

            searchInput.addEventListener("input", function() {
                const searchText = searchInput.value.toUpperCase().trim();

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return;

                    const code = row.cells[1].innerText.toUpperCase();

                    if (code.includes(searchText)) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    </script>
}
