@model QuanLyTourDuLich.ViewModels.KhuyenMaiViewModel

@{
    ViewData["Title"] = "Tạo Mã Khuyến Mãi Mới";
    ViewData["ActiveMenu"] = "KhuyenMai";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/KhuyenMai" class="text-decoration-none">Khuyến Mãi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tạo mã</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Tạo Mã Khuyến Mãi Mới
            </h1>
            <p class="text-muted mb-0">Thiết lập mã giảm giá mới, đặt tỉ lệ giảm (%) hoặc số tiền giảm trực tiếp và giới hạn ngày sử dụng.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Chương Trình Ưu Đãi</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/KhuyenMai/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <input asp-for="Code" class="form-control rounded-3 font-mono text-uppercase" placeholder="Nhập mã code (VD: SUMMERSALE2026)..." style="letter-spacing: 1px;" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhanTramGiam" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="PhanTramGiam" type="number" min="0" max="100" class="form-control rounded-start-3" placeholder="Nhập số phần trăm giảm..." />
                                    <span class="input-group-text bg-light">%</span>
                                </div>
                                <span asp-validation-for="PhanTramGiam" class="text-danger small"></span>
                                <small class="text-muted">Nhập từ 0 đến 100 (VD: 10 cho 10%).</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TienGiamTrucTiep" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="TienGiamTrucTiep" type="number" min="0" class="form-control rounded-start-3" placeholder="Nhập số tiền giảm trực tiếp..." />
                                    <span class="input-group-text bg-light">VND</span>
                                </div>
                                <span asp-validation-for="TienGiamTrucTiep" class="text-danger small"></span>
                                <small class="text-muted">Hoặc giảm trực tiếp bằng số tiền mặt cố định.</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayBatDau" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgayBatDau" type="date" class="form-control rounded-3" required />
                                <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayHetHan" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgayHetHan" type="date" class="form-control rounded-3" required />
                                <span asp-validation-for="NgayHetHan" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/KhuyenMai" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Tạo khuyến mãi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
