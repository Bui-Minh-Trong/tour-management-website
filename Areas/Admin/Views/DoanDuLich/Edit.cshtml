@model QuanLyTourDuLich.ViewModels.DoanDuLichFormVM

@{
    ViewData["Title"] = "Chỉnh Sửa Đoàn Du Lịch";
    ViewData["ActiveMenu"] = "Doan";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/DoanDuLich" class="text-decoration-none">Quản lý Đoàn</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa đoàn</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Chỉnh Sửa Đoàn Du Lịch
            </h1>
            <p class="text-muted mb-0">Cập nhật thông tin chi tiết hoặc trạng thái hoạt động của đoàn #@Model.MaDoan.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Đoàn</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/DoanDuLich/Edit/@Model.MaDoan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaDoan" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại các lỗi bên dưới:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="TenDoan" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <input asp-for="TenDoan" class="form-control rounded-3" placeholder="Nhập tên đoàn..." />
                            <span asp-validation-for="TenDoan" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaTour" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaTour" asp-items="Model.Tours" class="form-select rounded-3">
                                    <option value="">-- Chọn tour mẫu du lịch --</option>
                                </select>
                                <span asp-validation-for="MaTour" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaNvHuongDanVien" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaNvHuongDanVien" asp-items="Model.Guides" class="form-select rounded-3">
                                    <option value="">-- Chọn hướng dẫn viên --</option>
                                </select>
                                <span asp-validation-for="MaNvHuongDanVien" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayKhoiHanh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgayKhoiHanh" type="date" class="form-control rounded-3" />
                                <span asp-validation-for="NgayKhoiHanh" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayKetThuc" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgayKetThuc" type="date" class="form-control rounded-3" />
                                <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoLuongToiDa" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="SoLuongToiDa" type="number" min="1" class="form-control rounded-start-3" />
                                    <span class="input-group-text bg-light">Khách</span>
                                </div>
                                <span asp-validation-for="SoLuongToiDa" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoKhachHienTai" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="SoKhachHienTai" type="number" min="0" class="form-control rounded-start-3" readonly />
                                    <span class="input-group-text bg-light">Khách</span>
                                </div>
                                <span asp-validation-for="SoKhachHienTai" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TrangThaiDoan" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="TrangThaiDoan" class="form-select rounded-3">
                                    <option value="Lên kế hoạch">Lên kế hoạch</option>
                                    <option value="Đang nhận khách">Đang nhận khách</option>
                                    <option value="Đủ khách">Đủ khách</option>
                                    <option value="Đã khởi hành">Đã khởi hành</option>
                                    <option value="Đã kết thúc">Đã kết thúc</option>
                                    <option value="Đã hủy">Đã hủy</option>
                                </select>
                                <span asp-validation-for="TrangThaiDoan" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/DoanDuLich" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
