@model IEnumerable<QuanLyTourDuLich.ViewModels.DoanDuLichListVM>

@{
    ViewData["Title"] = "Quản lý Đoàn Du Lịch";
    ViewData["ActiveMenu"] = "Doan";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-users-rectangle text-primary me-2"></i>Quản Lý Đoàn Du Lịch
            </h1>
            <p class="text-muted mb-0">Quản lý các đoàn/chuyến đi du lịch thực tế đang và sắp triển khai.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/DoanDuLich/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Lập Đoàn Mới
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-6 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên đoàn, tên tour, HDV..." />
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Lên kế hoạch">Lên kế hoạch</option>
                        <option value="Đang nhận khách">Đang nhận khách</option>
                        <option value="Đủ khách">Đủ khách</option>
                        <option value="Đã khởi hành">Đã khởi hành</option>
                        <option value="Đã kết thúc">Đã kết thúc</option>
                        <option value="Đã hủy">Đã hủy</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="doanTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã</th>
                        <th>Tên Đoàn</th>
                        <th>Tour liên kết</th>
                        <th>Thời Gian Đi</th>
                        <th>Hướng Dẫn Viên</th>
                        <th class="text-center" style="width: 140px;">Sức Chứa</th>
                        <th class="text-center" style="width: 160px;">Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 180px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaDoan</td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-weight: 600;">@item.TenDoan</div>
                                </td>
                                <td>
                                    <div class="text-dark">@item.TenTour</div>
                                </td>
                                <td>
                                    <div class="small text-muted">
                                        <i class="fa-regular fa-calendar-check text-primary me-1"></i>
                                        @item.NgayKhoiHanh.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="fa-regular fa-calendar-times text-danger me-1"></i>
                                        @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="text-dark"><i class="fa-solid fa-user-tie text-secondary me-1"></i>@item.TenHuongDanVien</span>
                                </td>
                                <td class="text-center">
                                    <div class="progress rounded-pill mb-1" style="height: 6px;">
                                        @{
                                            var percent = (double)item.SoKhachHienTai / item.SoLuongToiDa * 100;
                                            var progressClass = percent >= 100 ? "bg-danger" : (percent >= 80 ? "bg-warning" : "bg-success");
                                        }
                                        <div class="progress-bar @progressClass" role="progressbar" style="width: @(percent > 100 ? 100 : percent)%" aria-valuenow="@item.SoKhachHienTai" aria-valuemin="0" aria-valuemax="@item.SoLuongToiDa"></div>
                                    </div>
                                    <span class="small font-weight-bold">@item.SoKhachHienTai/@item.SoLuongToiDa <small class="text-muted">khách</small></span>
                                </td>
                                <td class="text-center">
                                    @switch (item.TrangThaiDoan)
                                    {
                                        case "Lên kế hoạch":
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill"><i class="fa-solid fa-clock-rotate-left me-1"></i>Lên kế hoạch</span>
                                            break;
                                        case "Đang nhận khách":
                                            <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="fa-solid fa-user-plus me-1"></i>Đang nhận khách</span>
                                            break;
                                        case "Đủ khách":
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Đủ khách</span>
                                            break;
                                        case "Đã khởi hành":
                                            <span class="badge bg-info px-3 py-2 rounded-pill text-dark"><i class="fa-solid fa-bus-fast me-1"></i>Đã khởi hành</span>
                                            break;
                                        case "Đã kết thúc":
                                            <span class="badge bg-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-flag-checkered me-1"></i>Đã kết thúc</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i>Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill">@item.TrangThaiDoan</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Admin/DoanDuLich/Edit/@item.MaDoan" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa">
                                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                                        </a>
                                        <form action="/Admin/DoanDuLich/Delete/@item.MaDoan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đoàn này không?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-rectangle fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có đoàn du lịch nào được thiết lập.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const statusFilter = document.getElementById("statusFilter");
            const tableRows = document.querySelectorAll("#doanTable tbody tr");

            function filterTable() {
                const searchText = searchInput.value.toLowerCase().trim();
                const selectedStatus = statusFilter.value;

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return;
                    
                    const name = row.cells[1].innerText.toLowerCase();
                    const tourName = row.cells[2].innerText.toLowerCase();
                    const guide = row.cells[4].innerText.toLowerCase();
                    const statusText = row.cells[6].innerText.trim();

                    const matchesSearch = name.includes(searchText) || tourName.includes(searchText) || guide.includes(searchText);
                    const matchesStatus = selectedStatus === "" || statusText.includes(selectedStatus);

                    if (matchesSearch && matchesStatus) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            statusFilter.addEventListener("change", filterTable);
        });
    </script>
}
