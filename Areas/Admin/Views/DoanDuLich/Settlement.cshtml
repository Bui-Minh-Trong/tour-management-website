@model QuanLyTourDuLich.ViewModels.DoanSettlementVM
@{
    ViewData["Title"] = "Quyết Toán Đoàn";
    ViewData["ActiveMenu"] = "Doan";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/DoanDuLich" class="text-decoration-none">Đoàn Du Lịch</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quyết toán đoàn</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-calculator text-primary me-2"></i>Quyết Toán Doanh Thu & Chi Phí Đoàn
            </h1>
            <p class="text-muted mb-0">Thực hiện đối soát tài chính, tính toán lãi/lỗ và đóng hồ sơ đoàn: <strong>@Model.TenDoan</strong></p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="/Admin/DoanDuLich" class="btn btn-light border px-4 py-2 rounded-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Financial Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Revenue -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-uppercase text-secondary font-weight-bold fs-7">TỔNG THU (DOANH THU)</div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2">
                            <i class="fa-solid fa-arrow-down-long fs-5"></i>
                        </div>
                    </div>
                    <h3 class="font-weight-bold text-success mb-1">@Model.TongThu.ToString("N0") <small class="fs-6">VND</small></h3>
                    <p class="text-muted small mb-0">Từ tất cả các hóa đơn của khách hàng đăng ký đi tour</p>
                </div>
            </div>
        </div>

        <!-- Total Expense -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-uppercase text-secondary font-weight-bold fs-7">TỔNG CHI (CHI PHÍ ĐOÀN)</div>
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2">
                            <i class="fa-solid fa-arrow-up-long fs-5"></i>
                        </div>
                    </div>
                    <h3 class="font-weight-bold text-danger mb-1">@Model.TongChi.ToString("N0") <small class="fs-6">VND</small></h3>
                    <p class="text-muted small mb-0">Chi phí ăn uống, khách sạn, di chuyển, vé tham quan...</p>
                </div>
            </div>
        </div>

        <!-- Profit / Loss -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden @(Model.LoiNhuan >= 0 ? "bg-emerald-light" : "bg-rose-light")">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-uppercase font-weight-bold fs-7 @(Model.LoiNhuan >= 0 ? "text-success" : "text-danger")">LỢI NHUẬN (LÃI / LỖ)</div>
                        <div class="rounded-circle p-2 @(Model.LoiNhuan >= 0 ? "bg-success bg-opacity-15 text-success" : "bg-danger bg-opacity-15 text-danger")">
                            <i class="fa-solid @(Model.LoiNhuan >= 0 ? "fa-chart-line-up" : "fa-chart-line-down") fs-5"></i>
                        </div>
                    </div>
                    <h3 class="font-weight-bold mb-1 @(Model.LoiNhuan >= 0 ? "text-success" : "text-danger")">
                        @(Model.LoiNhuan >= 0 ? "+" : "")@Model.LoiNhuan.ToString("N0") <small class="fs-6">VND</small>
                    </h3>
                    <p class="small mb-0 @(Model.LoiNhuan >= 0 ? "text-success-emphasis" : "text-danger-emphasis")">
                        Hiệu suất tài chính: <strong>@(Model.LoiNhuan >= 0 ? "CÓ LÃI" : "BỊ LỖ")</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Incomes and Expenses Details -->
        <div class="col-lg-8">
            <!-- Table: Incomes -->
            <div class="card border-0 shadow-sm rounded-3 card-table mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">
                        <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Bảng kê các khoản thu
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 font-weight-bold rounded-pill">
                        @Model.Incomes.Count hóa đơn
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                            <tr>
                                <th class="ps-4">Mã HĐ</th>
                                <th>Khách Hàng</th>
                                <th>Ngày Lập</th>
                                <th>Hình Thức TT</th>
                                <th class="text-end pe-4">Số Tiền (VND)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Incomes != null && Model.Incomes.Any())
                            {
                                foreach (var inc in Model.Incomes)
                                {
                                    <tr>
                                        <td class="ps-4 font-weight-bold text-primary">#@inc.MaHoaDon</td>
                                        <td class="font-weight-semibold text-dark">@inc.TenKhachHang</td>
                                        <td>@inc.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">@inc.HinhThucTt</span>
                                        </td>
                                        <td class="text-end font-weight-bold text-success pe-4">@inc.SoTien.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Không có hóa đơn thu tiền nào cho đoàn này.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Table: Expenses -->
            <div class="card border-0 shadow-sm rounded-3 card-table">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">
                        <i class="fa-solid fa-receipt text-danger me-2"></i>Bảng kê các khoản chi
                    </h5>
                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1.5 font-weight-bold rounded-pill">
                        @Model.Expenses.Count phiếu chi
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                            <tr>
                                <th class="ps-4">Mã CP</th>
                                <th>Loại Chi Phí</th>
                                <th>Ghi Chú</th>
                                <th class="text-end pe-4">Số Tiền (VND)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Expenses != null && Model.Expenses.Any())
                            {
                                foreach (var exp in Model.Expenses)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted">#@exp.MaChiPhi</td>
                                        <td class="font-weight-semibold text-dark">@exp.LoaiChiPhi</td>
                                        <td class="text-muted text-truncate" style="max-width: 250px;" title="@exp.GhiChu">@exp.GhiChu</td>
                                        <td class="text-end font-weight-bold text-danger pe-4">@exp.SoTien.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        Chưa ghi nhận chi phí nào cho đoàn này.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Settlement Info & Action -->
        <div class="col-lg-4">
            <!-- Group Details -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông Tin Đoàn Du Lịch</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Đoàn:</span>
                            <strong class="text-dark text-end">@Model.TenDoan</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Tour:</span>
                            <strong class="text-dark text-end">@Model.TenTour</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Khởi hành:</span>
                            <strong class="text-dark text-end">@Model.NgayKhoiHanh.ToString("dd/MM/yyyy")</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Kết thúc:</span>
                            <strong class="text-dark text-end">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Hướng dẫn viên:</span>
                            <strong class="text-dark text-end">@Model.TenHuongDanVien</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Số lượng khách:</span>
                            <strong class="text-dark text-end">@Model.SoKhachHienTai người</strong>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Quyết toán:</span>
                            @if (Model.TrangThaiQuyetToan == "Đã quyết toán")
                            {
                                <span class="badge bg-success px-3 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Đã quyết toán</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill"><i class="fa-solid fa-clock-rotate-left me-1"></i>Chưa quyết toán</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Lock Settlement Action Card -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Khóa Quyết Toán</h5>
                </div>
                <div class="card-body p-4 text-center">
                    @if (Model.TrangThaiQuyetToan == "Đã quyết toán")
                    {
                        <div class="text-success mb-3">
                            <i class="fa-solid fa-circle-check fa-3x"></i>
                        </div>
                        <h6 class="font-weight-bold text-dark mb-1">Đoàn đã được khóa quyết toán!</h6>
                        <p class="text-muted small mb-0">Hồ sơ tài chính và nhật ký hành trình đã được lưu kho lưu trữ, không thể chỉnh sửa.</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-4 text-start">
                            Vui lòng kiểm tra kỹ tất cả các hóa đơn thu tiền và các phiếu chi phí đoàn trước khi xác nhận. Sau khi bấm nút xác nhận quyết toán, trạng thái đoàn sẽ chuyển sang <strong>Đã kết thúc</strong> để khóa sổ tài chính.
                        </p>

                        <form asp-action="ConfirmSettlement" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận quyết toán và khóa sổ đoàn này không?');">
                            <input type="hidden" name="groupId" value="@Model.MaDoan" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-semibold shadow-sm">
                                <i class="fa-solid fa-lock me-2"></i>Xác Nhận Quyết Toán
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
