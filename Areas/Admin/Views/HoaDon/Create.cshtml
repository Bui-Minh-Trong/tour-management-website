@model QuanLyTourDuLich.ViewModels.HoaDonFormVM

@{
    ViewData["Title"] = "Lập Phiếu Thu Tiền";
    ViewData["ActiveMenu"] = "HoaDon";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/HoaDon" class="text-decoration-none">Hóa Đơn</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lập phiếu thu</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Lập Phiếu Thu Tiền Tour
            </h1>
            <p class="text-muted mb-0">Lập hóa đơn ghi nhận giao dịch thanh toán đặt cọc hoặc thanh toán nốt của khách đi tour.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin Phiếu Thu / Hóa Đơn</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/HoaDon/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại các lỗi bên dưới:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaDangKy" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaDangKy" asp-items="Model.Bookings" class="form-select rounded-3">
                                    <option value="">-- Chọn phiếu đặt tour cần thu tiền --</option>
                                </select>
                                <span asp-validation-for="MaDangKy" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaNvLap" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaNvLap" asp-items="Model.Staffs" class="form-select rounded-3">
                                    <option value="">-- Chọn nhân viên lập phiếu --</option>
                                </select>
                                <span asp-validation-for="MaNvLap" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoTien" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="SoTien" type="number" min="1000" class="form-control rounded-start-3" placeholder="Nhập số tiền thu..." />
                                    <span class="input-group-text bg-light">VND</span>
                                </div>
                                <span asp-validation-for="SoTien" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LoaiHoaDon" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="LoaiHoaDon" class="form-select rounded-3">
                                    <option value="Đặt cọc">Đặt cọc</option>
                                    <option value="Thanh toán nốt">Thanh toán nốt</option>
                                    <option value="Toàn bộ">Toàn bộ</option>
                                </select>
                                <span asp-validation-for="LoaiHoaDon" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="HinhThucTt" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="HinhThucTt" class="form-select rounded-3">
                                    <option value="Tiền mặt">Tiền mặt</option>
                                    <option value="Chuyển khoản">Chuyển khoản</option>
                                    <option value="Ví điện tử">Ví điện tử</option>
                                </select>
                                <span asp-validation-for="HinhThucTt" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/HoaDon" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Lập phiếu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
