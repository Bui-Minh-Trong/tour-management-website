@model IEnumerable<QuanLyTourDuLich.ViewModels.HoaDonListVM>

@{
    ViewData["Title"] = "Quản lý Hóa Đơn";
    ViewData["ActiveMenu"] = "HoaDon";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Quản Lý Hóa Đơn & Tài Chính
            </h1>
            <p class="text-muted mb-0">Quản lý lịch sử giao dịch thanh toán và lập phiếu thu tiền tour.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/HoaDon/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Lập Phiếu Thu Tiền
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filters -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-6 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo mã đăng ký, khách hàng, hình thức TT..." />
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <select id="typeFilter" class="form-select">
                        <option value="">-- Tất cả loại thanh toán --</option>
                        <option value="Đặt cọc">Đặt cọc</option>
                        <option value="Thanh toán nốt">Thanh toán nốt</option>
                        <option value="Toàn bộ">Toàn bộ</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="invoiceTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Số HD</th>
                        <th style="width: 120px;">Mã Đăng Ký</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Lập HĐ</th>
                        <th class="text-end" style="width: 160px;">Số Tiền Thu</th>
                        <th>Loại Hóa Đơn</th>
                        <th>Hình Thức TT</th>
                        <th>Nhân Viên Lập</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-dark">#@item.MaHoaDon</td>
                                <td class="font-weight-semibold text-primary">#@item.MaDangKy</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.TenKhachHang</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 250px;">@item.TenDoan</small>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="fa-regular fa-clock me-1"></i>@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="text-end font-weight-bold text-success">
                                    +@item.SoTien.ToString("N0") <small>VND</small>
                                </td>
                                <td>
                                    @switch (item.LoaiHoaDon)
                                    {
                                        case "Đặt cọc":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Đặt cọc</span>
                                            break;
                                        case "Thanh toán nốt":
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">Thanh toán nốt</span>
                                            break;
                                        case "Toàn bộ":
                                            <span class="badge bg-success px-3 py-2 rounded-pill">Toàn bộ</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill">@item.LoaiHoaDon</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (item.HinhThucTt)
                                    {
                                        case "Tiền mặt":
                                            <span class="text-dark"><i class="fa-solid fa-money-bill-1 text-success me-1"></i>Tiền mặt</span>
                                            break;
                                        case "Chuyển khoản":
                                            <span class="text-primary"><i class="fa-solid fa-building-columns text-primary me-1"></i>Chuyển khoản</span>
                                            break;
                                        case "Ví điện tử":
                                            <span class="text-purple" style="color: #d946ef;"><i class="fa-solid fa-mobile-screen-button me-1"></i>Ví điện tử</span>
                                            break;
                                        default:
                                            <span class="text-secondary">@item.HinhThucTt</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="text-dark"><i class="fa-solid fa-user-tie text-secondary me-1"></i>@item.TenNhanVienLap</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-invoice-dollar fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có lịch sử giao dịch hóa đơn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const typeFilter = document.getElementById("typeFilter");
            const tableRows = document.querySelectorAll("#invoiceTable tbody tr");

            function filterTable() {
                const searchText = searchInput.value.toLowerCase().trim();
                const selectedType = typeFilter.value;

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return;

                    const codeReg = row.cells[1].innerText.toLowerCase();
                    const customer = row.cells[2].innerText.toLowerCase();
                    const paymentType = row.cells[6].innerText.toLowerCase();
                    const invoiceType = row.cells[5].innerText.trim();

                    const matchesSearch = codeReg.includes(searchText) || customer.includes(searchText) || paymentType.includes(searchText);
                    const matchesType = selectedType === "" || invoiceType.includes(selectedType);

                    if (matchesSearch && matchesType) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            typeFilter.addEventListener("change", filterTable);
        });
    </script>
}
