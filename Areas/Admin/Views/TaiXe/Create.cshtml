@model QuanLyTourDuLich.ViewModels.TaiXeViewModel

@{
    ViewData["Title"] = "Thêm Tài Xế Mới";
    ViewData["ActiveMenu"] = "TaiXe";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/TaiXe" class="text-decoration-none">Tài Xế</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Thêm Tài Xế Mới
            </h1>
            <p class="text-muted mb-0">Thiết lập hồ sơ cá nhân, số giấy phép lái xe và hạng bằng lái của tài xế mới tuyển dụng.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin tài xế</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/TaiXe/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="HoTen" class="form-control rounded-3" placeholder="Nhập họ và tên tài xế..." required />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Sdt" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Sdt" class="form-control rounded-3" placeholder="Nhập số điện thoại liên hệ..." required />
                                <span asp-validation-for="Sdt" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoGplx" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="SoGplx" class="form-control rounded-3 font-mono" placeholder="Nhập số GPLX (12 số)..." required />
                                <span asp-validation-for="SoGplx" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LoaiBangLai" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="LoaiBangLai" class="form-select rounded-3" required>
                                    <option value="Hạng B2">Hạng B2 (Xe dưới 9 chỗ)</option>
                                    <option value="Hạng C">Hạng C (Xe tải)</option>
                                    <option value="Hạng D">Hạng D (Xe dưới 30 chỗ)</option>
                                    <option value="Hạng E">Hạng E (Xe trên 30 chỗ)</option>
                                    <option value="Hạng F">Hạng F (Xe đầu kéo/Container)</option>
                                </select>
                                <span asp-validation-for="LoaiBangLai" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/TaiXe" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Thêm tài xế
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
