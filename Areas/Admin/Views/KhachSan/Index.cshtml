@model IEnumerable<QuanLyTourDuLich.ViewModels.KhachSanViewModel>

@{
    ViewData["Title"] = "Quản lý Khách Sạn";
    ViewData["ActiveMenu"] = "KhachSan";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-hotel text-primary me-2"></i>Quản Lý Khách Sạn
            </h1>
            <p class="text-muted mb-0">Quản lý danh sách đối tác lưu trú liên kết phục vụ các đoàn khách du lịch.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/KhachSan/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Thêm Khách Sạn
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hotels Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã</th>
                        <th>Tên Khách Sạn</th>
                        <th>Hạng Sao</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ</th>
                        <th class="text-center pe-4" style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaKs</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.TenKs</div>
                                </td>
                                <td>
                                    <span class="text-warning">
                                        @for (int i = 0; i < item.SoSao; i++)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        @for (int i = item.SoSao; i < 5; i++)
                                        {
                                            <i class="fa-regular fa-star text-muted"></i>
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="font-weight-semibold text-dark"><i class="fa-solid fa-phone text-secondary me-1"></i>@item.Sdt</span>
                                </td>
                                <td>
                                    <span class="text-muted">@item.DiaChi</span>
                                </td>
                                <td class="text-center pe-4">
                                    <form action="/Admin/KhachSan/Delete/@item.MaKs" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách sạn này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-hotel fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có khách sạn đối tác nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
