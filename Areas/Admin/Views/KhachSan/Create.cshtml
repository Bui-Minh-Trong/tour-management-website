@model QuanLyTourDuLich.ViewModels.KhachSanViewModel

@{
    ViewData["Title"] = "Thêm Khách Sạn Mới";
    ViewData["ActiveMenu"] = "KhachSan";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/KhachSan" class="text-decoration-none">Khách Sạn</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Thêm Đối Tác Khách Sạn Mới
            </h1>
            <p class="text-muted mb-0">Thiết lập hồ sơ lưu trú đối tác mới phục vụ việc đặt phòng nghỉ khi lưu trú.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Khách Sạn</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/KhachSan/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenKs" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="TenKs" class="form-control rounded-3" placeholder="Nhập tên khách sạn..." required />
                                <span asp-validation-for="TenKs" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoSao" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="SoSao" class="form-select rounded-3" required>
                                    <option value="1">1 Sao</option>
                                    <option value="2">2 Sao</option>
                                    <option value="3">3 Sao</option>
                                    <option value="4">4 Sao</option>
                                    <option value="5">5 Sao</option>
                                </select>
                                <span asp-validation-for="SoSao" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Sdt" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Sdt" class="form-control rounded-3" placeholder="Nhập số điện thoại liên hệ..." required />
                                <span asp-validation-for="Sdt" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DiaChi" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="DiaChi" class="form-control rounded-3" placeholder="Nhập địa chỉ khách sạn..." required />
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/KhachSan" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Thêm khách sạn
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
