@model QuanLyTourDuLich.ViewModels.BookingFormVM

@{
    ViewData["Title"] = "Đặt Tour Cho Khách";
    ViewData["ActiveMenu"] = "Booking";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/Booking" class="text-decoration-none">Đặt Tour</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đặt tour cho khách</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Đặt Tour Cho Khách Hàng
            </h1>
            <p class="text-muted mb-0">Lập phiếu đặt tour cho khách hàng đại diện, áp dụng mã giảm giá và cài đặt số người đi.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin Phiếu Đặt Tour</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/Booking/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại các lỗi bên dưới:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaKh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaKh" asp-items="Model.Customers" class="form-select rounded-3">
                                    <option value="">-- Chọn khách hàng đại diện --</option>
                                </select>
                                <span asp-validation-for="MaKh" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaDoan" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaDoan" asp-items="Model.TourGroups" class="form-select rounded-3">
                                    <option value="">-- Chọn đoàn du lịch đi tour --</option>
                                </select>
                                <span asp-validation-for="MaDoan" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoNguoiDi" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="SoNguoiDi" type="number" min="1" class="form-control rounded-start-3" />
                                    <span class="input-group-text bg-light">Người</span>
                                </div>
                                <span asp-validation-for="SoNguoiDi" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DonGia" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="DonGia" type="number" min="1000" class="form-control rounded-start-3" />
                                    <span class="input-group-text bg-light">VND</span>
                                </div>
                                <span asp-validation-for="DonGia" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CodeKhuyenMai" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="CodeKhuyenMai" class="form-control rounded-3" placeholder="Nhập mã KM..." />
                                <span asp-validation-for="CodeKhuyenMai" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TrangThaiThanhToan" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="TrangThaiThanhToan" class="form-select rounded-3">
                                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                                    <option value="Đã cọc">Đã cọc</option>
                                    <option value="Đã thanh toán">Đã thanh toán</option>
                                </select>
                                <span asp-validation-for="TrangThaiThanhToan" class="text-danger small"></span>
                            </div>
                            @* MaNvKinhDoanh: Tương ứng với SaleID trong Class Diagram *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaNvKinhDoanh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="MaNvKinhDoanh" asp-items="Model.SaleStaffs" class="form-select rounded-3">
                                    <option value="">-- Chọn nhân viên kinh doanh --</option>
                                </select>
                                <span asp-validation-for="MaNvKinhDoanh" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GhiChu" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <input asp-for="GhiChu" class="form-control rounded-3" placeholder="Ghi chú thêm..." />
                            <span asp-validation-for="GhiChu" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/Booking" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Đặt tour
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
