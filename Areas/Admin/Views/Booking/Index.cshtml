@model IEnumerable<QuanLyTourDuLich.ViewModels.BookingListVM>

@{
    ViewData["Title"] = "Danh Sách Đặt Tour";
    ViewData["ActiveMenu"] = "Booking";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-ticket text-primary me-2"></i>Quản Lý Đặt Tour
            </h1>
            <p class="text-muted mb-0">Quản lý phiếu đặt tour của khách hàng và theo dõi thanh toán.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/Booking/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Đặt Tour Cho Khách
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filters -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-6 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên khách, tên đoàn du lịch..." />
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <select id="paymentFilter" class="form-select">
                        <option value="">-- Tất cả thanh toán --</option>
                        <option value="Đã thanh toán">Đã thanh toán</option>
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                        <option value="Đã cọc">Đã cọc</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="bookingTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Mã ĐK</th>
                        <th>Khách Hàng</th>
                        <th>Đoàn Du Lịch</th>
                        <th class="text-center" style="width: 120px;">Số Người</th>
                        <th>Ngày Đăng Ký</th>
                        <th class="text-end" style="width: 150px;">Tổng Tiền</th>
                        <th class="text-center" style="width: 160px;">Thanh Toán</th>
                        <th class="text-center pe-4" style="width: 200px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaDangKy</td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-weight: 600;">@item.TenKhachHang</div>
                                </td>
                                <td>
                                    <div class="text-dark font-weight-semibold">@item.TenDoan</div>
                                </td>
                                <td class="text-center font-weight-bold text-dark">
                                    @item.SoNguoiDi
                                </td>
                                <td>
                                    <span class="text-muted"><i class="fa-regular fa-clock me-1"></i>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="text-end font-weight-bold text-dark">
                                    @item.TongTien.ToString("N0") <small class="text-muted">VND</small>
                                </td>
                                <td class="text-center">
                                    @switch (item.TrangThaiThanhToan)
                                    {
                                        case "Đã thanh toán":
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán</span>
                                            break;
                                        case "Chưa thanh toán":
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i>Chưa thanh toán</span>
                                            break;
                                        case "Đã cọc":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-minus me-1"></i>Đã cọc</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill">@item.TrangThaiThanhToan</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (item.TrangThaiThanhToan != "Đã thanh toán")
                                        {
                                            <a href="/Admin/HoaDon/Create?bookingId=@item.MaDangKy" class="btn btn-xs btn-success text-white rounded-3 px-2 py-1 fs-7" title="Lập hóa đơn thu tiền">
                                                <i class="fa-solid fa-file-invoice-dollar"></i> Thu tiền
                                            </a>
                                        }
                                        <form action="/Admin/Booking/Delete/@item.MaDangKy" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đặt tour này không?');">
                                            <button type="submit" class="btn btn-xs btn-outline-danger rounded-3 px-2 py-1 fs-7" title="Hủy đặt tour">
                                                <i class="fa-solid fa-trash"></i> Hủy
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-ticket fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có phiếu đặt tour nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const paymentFilter = document.getElementById("paymentFilter");
            const tableRows = document.querySelectorAll("#bookingTable tbody tr");

            function filterTable() {
                const searchText = searchInput.value.toLowerCase().trim();
                const selectedPayment = paymentFilter.value;

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return;

                    const customer = row.cells[1].innerText.toLowerCase();
                    const group = row.cells[2].innerText.toLowerCase();
                    const payment = row.cells[6].innerText.trim();

                    const matchesSearch = customer.includes(searchText) || group.includes(searchText);
                    const matchesPayment = selectedPayment === "" || payment.includes(selectedPayment);

                    if (matchesSearch && matchesPayment) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            paymentFilter.addEventListener("change", filterTable);
        });
    </script>
}
