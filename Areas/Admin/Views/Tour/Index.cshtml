@model IEnumerable<QuanLyTourDuLich.ViewModels.TourViewModel>

@{
    ViewData["Title"] = "Quản lý Tour";
    ViewData["ActiveMenu"] = "Tour";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-route text-primary me-2"></i>Danh Sách Tour Du Lịch
            </h1>
            <p class="text-muted mb-0">Quản lý danh mục các tour du lịch hiện có trong hệ thống.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/Tour/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-plus me-2"></i>Thêm Mới Tour
            </a>
        </div>
    </div>

    <!-- Alert Messages if any -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-6 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên tour, điểm đến..." />
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <select id="vehicleFilter" class="form-select">
                        <option value="">-- Tất cả phương tiện --</option>
                        <option value="Máy bay">Máy bay</option>
                        <option value="Xe khách">Xe khách</option>
                        <option value="Tàu hỏa">Tàu hỏa</option>
                        <option value="Tàu thủy">Tàu thủy</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tour Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tourTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã Tour</th>
                        <th>Tên Tour</th>
                        <th>Điểm Đến</th>
                        <th class="text-center" style="width: 120px;">Thời Gian</th>
                        <th style="width: 150px;">Phương Tiện</th>
                        <th class="text-end" style="width: 180px;">Giá Tham Khảo</th>
                        <th class="text-center pe-4" style="width: 180px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var tour in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@tour.MaTour</td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-weight: 600;">@tour.TenTour</div>
                                    @if (!string.IsNullOrEmpty(tour.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-block" style="max-width: 300px;">@tour.MoTa</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@tour.DiaDiem
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="font-weight-semibold">@tour.ThoiGian ngày</span>
                                </td>
                                <td>
                                    @switch (tour.PhuongTienChinh)
                                    {
                                        case "Máy bay":
                                            <span class="text-info"><i class="fa-solid fa-plane me-1"></i>Máy bay</span>
                                            break;
                                        case "Xe khách":
                                            <span class="text-success"><i class="fa-solid fa-bus me-1"></i>Xe khách</span>
                                            break;
                                        case "Tàu hỏa":
                                            <span class="text-warning"><i class="fa-solid fa-train me-1"></i>Tàu hỏa</span>
                                            break;
                                        case "Tàu thủy":
                                            <span class="text-primary"><i class="fa-solid fa-ship me-1"></i>Tàu thủy</span>
                                            break;
                                        default:
                                            <span class="text-secondary"><i class="fa-solid fa-van-shuttle me-1"></i>@tour.PhuongTienChinh</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end font-weight-bold text-danger" style="font-weight: 600;">
                                    @tour.GiaThamKhao.ToString("N0") <small>VND</small>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Admin/Tour/Edit/@tour.MaTour" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa">
                                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                                        </a>
                                        <form action="/Admin/Tour/Delete/@tour.MaTour" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tour này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-route fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có dữ liệu tour nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const vehicleFilter = document.getElementById("vehicleFilter");
            const tableRows = document.querySelectorAll("#tourTable tbody tr");

            function filterTable() {
                const searchText = searchInput.value.toLowerCase().trim();
                const selectedVehicle = vehicleFilter.value;

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return; // Skip empty row
                    
                    const name = row.cells[1].innerText.toLowerCase();
                    const location = row.cells[2].innerText.toLowerCase();
                    const vehicle = row.cells[4].innerText;

                    const matchesSearch = name.includes(searchText) || location.includes(searchText);
                    const matchesVehicle = selectedVehicle === "" || vehicle.includes(selectedVehicle);

                    if (matchesSearch && matchesVehicle) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            vehicleFilter.addEventListener("change", filterTable);
        });
    </script>
}
