@model QuanLyTourDuLich.ViewModels.TourViewModel

@{
    ViewData["Title"] = "Thêm Mới Tour";
    ViewData["ActiveMenu"] = "Tour";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/Tour" class="text-decoration-none">Quản lý Tour</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thêm mới Tour</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Thêm Mới Tour Du Lịch
            </h1>
            <p class="text-muted mb-0">Nhập đầy đủ thông tin để thêm tour du lịch mới vào hệ thống.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Tour</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/Tour/Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại các lỗi bên dưới:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="TenTour" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <input asp-for="TenTour" class="form-control rounded-3" placeholder="Nhập tên tour du lịch..." />
                            <span asp-validation-for="TenTour" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DiaDiem" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="DiaDiem" class="form-control rounded-3" placeholder="Ví dụ: Nha Trang, Đà Lạt..." />
                                <span asp-validation-for="DiaDiem" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThoiGian" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="ThoiGian" type="number" min="1" class="form-control rounded-start-3" placeholder="Số ngày..." />
                                    <span class="input-group-text bg-light">Ngày</span>
                                </div>
                                <span asp-validation-for="ThoiGian" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhuongTienChinh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="PhuongTienChinh" class="form-select rounded-3">
                                    <option value="">-- Chọn phương tiện chính --</option>
                                    <option value="Máy bay">Máy bay</option>
                                    <option value="Xe khách">Xe khách</option>
                                    <option value="Tàu hỏa">Tàu hỏa</option>
                                    <option value="Tàu thủy">Tàu thủy</option>
                                </select>
                                <span asp-validation-for="PhuongTienChinh" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GiaThamKhao" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <div class="input-group">
                                    <input asp-for="GiaThamKhao" type="text" class="form-control rounded-start-3 currency-input" placeholder="Nhập giá..." step="100000" />
                                    <span class="input-group-text bg-light">VND</span>
                                </div>
                                <span asp-validation-for="GiaThamKhao" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HinhAnhUpload" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <input asp-for="HinhAnhUpload" type="file" class="form-control rounded-3" accept="image/*" />
                            <span asp-validation-for="HinhAnhUpload" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <textarea asp-for="MoTa" class="form-control rounded-3" rows="4" placeholder="Nhập mô tả lịch trình tóm tắt hoặc ghi chú..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/Tour" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
