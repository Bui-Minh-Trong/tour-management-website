@model QuanLyTourDuLich.ViewModels.NhanVienViewModel

@{
    ViewData["Title"] = "Thêm Nhân Viên Mới";
    ViewData["ActiveMenu"] = "NhanVien";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/NhanVien" class="text-decoration-none">Nhân Sự</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-plus text-primary me-2"></i>Thêm Nhân Viên Mới
            </h1>
            <p class="text-muted mb-0">Nhập đầy đủ thông tin nhân sự để lưu trữ hồ sơ và quản lý hoạt động.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Nhân Viên</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/NhanVien/Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="HoTen" class="form-control rounded-3" placeholder="Nhập họ và tên nhân viên..." required />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ChucVu" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="ChucVu" class="form-select rounded-3" required>
                                    <option value="">-- Chọn chức vụ --</option>
                                    <option value="Quản lý điều hành">Quản lý điều hành</option>
                                    <option value="Hướng dẫn viên">Hướng dẫn viên</option>
                                    <option value="Kế toán tài chính">Kế toán tài chính</option>
                                    <option value="Nhân viên tư vấn bán hàng">Nhân viên tư vấn bán hàng</option>
                                    <option value="Nhân viên hỗ trợ khách hàng">Nhân viên hỗ trợ khách hàng</option>
                                </select>
                                <span asp-validation-for="ChucVu" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Sdt" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Sdt" class="form-control rounded-3" placeholder="Nhập số điện thoại (10 số)..." required />
                                <span asp-validation-for="Sdt" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Nhập địa chỉ email..." />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayVaoLam" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgayVaoLam" type="date" class="form-control rounded-3" required />
                                <span asp-validation-for="NgayVaoLam" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/NhanVien" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Thêm nhân viên
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
