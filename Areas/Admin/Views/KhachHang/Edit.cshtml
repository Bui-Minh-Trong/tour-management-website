@model QuanLyTourDuLich.ViewModels.KhachHangViewModel

@{
    ViewData["Title"] = "Chỉnh Sửa Khách Hàng";
    ViewData["ActiveMenu"] = "KhachHang";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/KhachHang" class="text-decoration-none">Khách Hàng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Chỉnh Sửa Thông Tin Khách Hàng
            </h1>
            <p class="text-muted mb-0">Cập nhật hồ sơ khách hàng mã #@Model.MaKh.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h5 class="mb-0 font-weight-bold text-dark" style="font-weight: 600;">Thông tin chi tiết Khách Hàng</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/KhachHang/Edit/@Model.MaKh" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaKh" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                        <div asp-validation-summary="All" class="text-danger mt-1 small"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="HoTen" class="form-control rounded-3" placeholder="Nhập họ và tên..." required />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GioiTinh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <select asp-for="GioiTinh" class="form-select rounded-3">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                </select>
                                <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgaySinh" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="NgaySinh" type="date" class="form-control rounded-3" />
                                <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Sdt" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Sdt" class="form-control rounded-3" placeholder="Nhập số điện thoại..." required />
                                <span asp-validation-for="Sdt" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Nhập email..." />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cccd" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                                <input asp-for="Cccd" class="form-control rounded-3" placeholder="Nhập số CCCD..." />
                                <span asp-validation-for="Cccd" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiaChi" class="form-label font-weight-semibold" style="font-weight: 500;"></label>
                            <textarea asp-for="DiaChi" rows="2" class="form-control rounded-3" placeholder="Địa chỉ thường trú..."></textarea>
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Admin/KhachHang" class="btn btn-light px-4 py-2 rounded-3 border">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="fa-solid fa-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
