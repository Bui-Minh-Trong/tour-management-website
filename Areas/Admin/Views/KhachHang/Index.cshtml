@model IEnumerable<QuanLyTourDuLich.ViewModels.KhachHangViewModel>

@{
    ViewData["Title"] = "Quản lý Khách Hàng";
    ViewData["ActiveMenu"] = "KhachHang";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="font-weight: 700;">
                <i class="fa-solid fa-users text-primary me-2"></i>Quản Lý Khách Hàng
            </h1>
            <p class="text-muted mb-0">Hồ sơ lưu trữ và thông tin liên lạc của các khách hàng đăng ký đi tour.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/Admin/KhachHang/Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
                <i class="fa-solid fa-user-plus me-2"></i>Thêm Khách Hàng
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo họ tên, số điện thoại, CCCD, địa chỉ..." />
            </div>
        </div>
    </div>

    <!-- Customers Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden card-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="khachHangTable">
                <thead class="table-light text-uppercase fs-7 font-weight-bold text-secondary">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Mã KH</th>
                        <th>Họ Tên</th>
                        <th style="width: 100px;">Giới Tính</th>
                        <th>Ngày Sinh</th>
                        <th>Số Điện Thoại</th>
                        <th>Email</th>
                        <th>Số CCCD</th>
                        <th>Địa Chỉ</th>
                        <th class="text-center pe-4" style="width: 180px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-primary">#@item.MaKh</td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-weight: 600;">@item.HoTen</div>
                                </td>
                                <td>
                                    @if (item.GioiTinh == "Nam")
                                    {
                                        <span class="badge bg-blue-light text-primary px-2.5 py-1.5"><i class="fa-solid fa-mars me-1"></i>Nam</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-pink-light text-danger px-2.5 py-1.5"><i class="fa-solid fa-venus me-1"></i>Nữ</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-dark">@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="font-weight-semibold text-dark"><i class="fa-solid fa-phone text-secondary me-1"></i>@item.Sdt</span>
                                </td>
                                <td>
                                    <span class="text-muted">@(item.Email ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="text-dark">@(item.Cccd ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="text-muted text-truncate d-inline-block" style="max-width: 150px;" title="@item.DiaChi">@(item.DiaChi ?? "N/A")</span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Admin/KhachHang/Edit/@item.MaKh" class="btn btn-sm btn-outline-primary rounded-3" title="Sửa thông tin">
                                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                                        </a>
                                        <form action="/Admin/KhachHang/Delete/@item.MaKh" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hồ sơ khách hàng này không?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users fs-1 mb-3 d-block text-secondary"></i>
                                Chưa có dữ liệu khách hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const tableRows = document.querySelectorAll("#khachHangTable tbody tr");

            searchInput.addEventListener("input", function() {
                const searchText = searchInput.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    if (row.cells.length < 2) return;

                    const name = row.cells[1].innerText.toLowerCase();
                    const phone = row.cells[4].innerText.toLowerCase();
                    const cccd = row.cells[6].innerText.toLowerCase();
                    const address = row.cells[7].innerText.toLowerCase();

                    const matches = name.includes(searchText) || phone.includes(searchText) || cccd.includes(searchText) || address.includes(searchText);

                    if (matches) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    </script>
}
